# Copy to .env next to llmbench.py (or in the folder you run it from) and fill in.
# Variables already exported in your shell take precedence over this file.

# LiteLLM proxy
LITELLM_BASE_URL=https://api.ctollama.home.arpa
# A LiteLLM virtual key is enough; the master key also works (LITELLM_MASTER_KEY=...)
LITELLM_API_KEY=sk-change-me

# TLS for the internal hostname - pick one if the cert isn't publicly trusted:
# REQUESTS_CA_BUNDLE=/path/to/your-root-ca.crt
# LITELLM_INSECURE=1
